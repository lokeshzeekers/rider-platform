# ==== Server ====
NODE_ENV=production
PORT=4000
# Bind to localhost only in production; Nginx reverse-proxies to this. Never expose 4000 publicly.
HOST=127.0.0.1

# ==== Database ====
DATABASE_URL=postgres://ridemesh_app:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/ridemesh
PG_POOL_MAX=20
PG_SSL=false

# ==== Auth / tokens ====
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret_different_from_access
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ==== CORS ====
# Comma-separated list of allowed browser origins. No wildcards in production.
CORS_ORIGINS=https://track.zeekerstech.com

# ==== Uploads ====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ==== Monetization (dormant) ====
# Leave false for the free launch period. Flipping to true activates plan/entitlement
# enforcement that is already wired into the schema and middleware.
MONETIZATION_ENABLED=false

# ==== SMS provider (for admin-assisted account recovery notifications) ====
# Wire your provider's credentials here; sms.js falls back to a logged no-op if unset.
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=

# ==== Logging ====
LOG_LEVEL=info
